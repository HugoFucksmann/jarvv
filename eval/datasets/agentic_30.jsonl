ous plan: no lo guardes como txt, quiero un archivo markdown llamado resumen.md.\nReplan taking the feedback into account.","json":true,"schema":{"type":"object","properties":{"steps":{"type":"array","items":{"type":"object","properties":{"goal":{"type":"string"},"suggested_mcp":{"type":"string","enum":["files","locate","terminal","web"]},"expected_outcome":{"type":"string"}},"required":["goal","suggested_mcp","expected_outcome"],"additionalProperties":false},"maxItems":5,"minItems":1}},"required":["steps"],"additionalProperties":false},"schemaName":"plan","maxTokens":4096,"temperature":0.1,"thinking":true},"expect":{"minSteps":2,"maxSteps":5,"allowedRoutes":["files","locate"],"requiredRoutes":["files"],"mustReflectFeedback":["resumen.md"]}}
