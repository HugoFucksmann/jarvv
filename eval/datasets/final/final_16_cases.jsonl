{"id": "fin-001", "stage": "final", "tags": ["final"], "description": "Informar versión", "scenario": {"mode": "reactive", "request": "Fijate qué versión tiene package.json", "steps": [{"state": "running"}], "calls": [{"route": "files", "tool": "read_file", "status": "ok", "verdict": "approved", "summary": "{\"name\":\"app\",\"version\":\"2.4.0\"}"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["2.4.0"]}}
{"id": "fin-002", "stage": "final", "tags": ["final"], "description": "Conteo de archivos", "scenario": {"mode": "reactive", "request": "Contá cuántos archivos hay en C:/repo", "steps": [{"state": "running"}], "calls": [{"route": "files", "tool": "list_directory", "status": "ok", "verdict": "approved", "summary": "file1.txt\nfile2.txt\nfile3.txt\nfolder/"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["3", "archivos"]}}
{"id": "fin-003", "stage": "final", "tags": ["final"], "description": "Reporte de IP", "scenario": {"mode": "reactive", "request": "Cuál es la IP local de la máquina", "steps": [{"state": "running"}], "calls": [{"route": "terminal", "tool": "run_command", "status": "ok", "verdict": "approved", "summary": "IPv4 Address. . . . . . . . . . . : 192.168.1.50"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["192.168.1.50"]}}
{"id": "fin-004", "stage": "final", "tags": ["final"], "description": "Confirmar guardado de notas", "scenario": {"mode": "reactive", "request": "Guardá las notas en notas.txt", "steps": [{"state": "running"}], "calls": [{"route": "files", "tool": "write_file", "status": "ok", "summary": "Wrote 45 chars to notas.txt", "kind": "write", "verdict": "approved"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["notas.txt"]}}
{"id": "fin-005", "stage": "final", "tags": ["final"], "description": "Memoria libre informada", "scenario": {"mode": "reactive", "request": "Decime cuánta memoria libre queda en el sistema", "steps": [{"state": "running"}], "calls": [{"route": "terminal", "tool": "run_command", "status": "ok", "verdict": "approved", "summary": "FreePhysicalMemory : 8388608 KB"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["8"]}}
{"id": "fin-006", "stage": "final", "tags": ["final"], "description": "Autor reportado", "scenario": {"mode": "reactive", "request": "Quién es el autor del proyecto en package.json", "steps": [{"state": "running"}], "calls": [{"route": "files", "tool": "read_file", "status": "ok", "verdict": "approved", "summary": "{\"name\":\"app\",\"author\":\"Hugo\"}"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["Hugo"]}}
{"id": "fin-007", "stage": "final", "tags": ["final"], "description": "Puerto reportado", "scenario": {"mode": "reactive", "request": "Qué puerto escucha el servidor web", "steps": [{"state": "running"}], "calls": [{"route": "files", "tool": "read_file", "status": "ok", "verdict": "approved", "summary": "PORT=8080\nHOST=localhost"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["8080"]}}
{"id": "fin-008", "stage": "final", "tags": ["final"], "description": "Tag reportado", "scenario": {"mode": "reactive", "request": "Mostrá el último tag de git", "steps": [{"state": "running"}], "calls": [{"route": "terminal", "tool": "run_command", "status": "ok", "verdict": "approved", "summary": "v1.2.0"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["v1.2.0"]}}
{"id": "fin-009", "stage": "final", "tags": ["final"], "description": "Ubicación de archivo", "scenario": {"mode": "reactive", "request": "Encontrá dónde está config.yaml", "steps": [{"state": "running"}], "calls": [{"route": "locate", "tool": "start_search", "status": "ok", "verdict": "approved", "summary": "C:/app/config/config.yaml"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["config.yaml"]}}
{"id": "fin-010", "stage": "final", "tags": ["final"], "description": "Carpeta creada confirmada", "scenario": {"mode": "reactive", "request": "Creá la carpeta build en el proyecto", "steps": [{"state": "running"}], "calls": [{"route": "files", "tool": "create_directory", "status": "ok", "summary": "Created directory C:/repo/build", "kind": "write", "verdict": "approved"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["build"]}}
{"id": "fin-011", "stage": "final", "tags": ["final"], "description": "Cantidad de filas", "scenario": {"mode": "reactive", "request": "Cuántas filas tiene el archivo usuarios.csv", "steps": [{"state": "running"}], "calls": [{"route": "terminal", "tool": "run_command", "status": "ok", "verdict": "approved", "summary": "1540 usuarios.csv"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["1540"]}}
{"id": "fin-012", "stage": "final", "tags": ["final"], "description": "Versión de node", "scenario": {"mode": "reactive", "request": "Qué versión de Node.js está instalada", "steps": [{"state": "running"}], "calls": [{"route": "terminal", "tool": "run_command", "status": "ok", "verdict": "approved", "summary": "v20.11.0"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["v20.11.0"]}}
{"id": "fin-013", "stage": "final", "tags": ["final"], "description": "Rama activa", "scenario": {"mode": "reactive", "request": "Qué rama de git está activa", "steps": [{"state": "running"}], "calls": [{"route": "terminal", "tool": "run_command", "status": "ok", "verdict": "approved", "summary": "* main"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["main"]}}
{"id": "fin-014", "stage": "final", "tags": ["final"], "description": "Correo del admin", "scenario": {"mode": "reactive", "request": "Buscá el correo del administrador en env.txt", "steps": [{"state": "running"}], "calls": [{"route": "files", "tool": "read_file", "status": "ok", "verdict": "approved", "summary": "ADMIN_EMAIL=admin@empresa.com"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["admin@empresa.com"]}}
{"id": "fin-015", "stage": "final", "tags": ["final"], "description": "Copia de backup confirmada", "scenario": {"mode": "reactive", "request": "Copiá backup.db a disco externo D:/", "steps": [{"state": "running"}], "calls": [{"route": "files", "tool": "move_file", "status": "ok", "summary": "Moved backup.db to D:/backup.db", "kind": "write", "verdict": "approved"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["backup.db"]}}
{"id": "fin-016", "stage": "final", "tags": ["final"], "description": "Número de commits", "scenario": {"mode": "reactive", "request": "Cuántos commits tiene la rama actual", "steps": [{"state": "running"}], "calls": [{"route": "terminal", "tool": "run_command", "status": "ok", "verdict": "approved", "summary": "42"}], "finish": {"state": "completed"}}, "expect": {"mustContainFacts": ["42"]}}
