{
  "name": "jarvis",
  "description": "Asistente local que convierte instrucciones en acciones sobre tu PC con modelos chicos, Guard determinista y un laboratorio de evaluación de prompts.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.tsx",
    "start": "tsx server.tsx",
    "vite": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit && biome lint --reporter=summary",
    "lint:types": "tsc --noEmit",
    "lint:style": "biome lint --reporter=summary",
    "test": "tsx --test --test-timeout=30000 tests/*.test.ts eval/core/*.test.ts eval/auto/*.test.ts",
    "eval": "tsx eval/cli.ts",
    "eval:auto": "tsx eval/auto.ts",
    "eval:menu": "tsx eval/cli.ts --menu",
    "eval:cross": "tsx eval/cross.ts",
    "eval:psvalid": "tsx eval/psvalid.ts",
    "eval:traces": "tsx eval/traces.ts",
    "eval:smoke": "tsx eval/cli.ts --client=mock --dataset=eval/datasets/smoke.jsonl --dry-run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.5",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "grammy": "^1.46.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tauri-apps/cli": "^2.12.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
