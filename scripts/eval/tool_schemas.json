{
  "_note": "inputSchemas tal como los ve el modelo (filtrados por manifest.ts). desktop_commander: extraído del servidor MCP vía stdio. free_search: reconstruido desde manifest.ts (uvx no disponible en esta PC).",

  "read_file": {
    "type": "object",
    "properties": {
      "path":   { "type": "string" },
      "isUrl":  { "type": "boolean", "default": false },
      "offset": { "type": "number", "default": 0 },
      "length": { "type": "number", "default": 1000 },
      "sheet":  { "type": "string" },
      "range":  { "type": "string" }
    },
    "required": ["path"]
  },

  "read_multiple_files": {
    "type": "object",
    "properties": {
      "paths": { "type": "array", "items": { "type": "string" } }
    },
    "required": ["paths"]
  },

  "write_file": {
    "type": "object",
    "properties": {
      "path":    { "type": "string" },
      "content": { "type": "string", "description": "Text of the file. For .xlsx/.xls/.xlsm: a JSON string of a 2D array of rows, e.g. [[\"Name\",\"Age\"],[\"Alice\",30]], or of an object {\"SheetName\": [[...]]}." },
      "mode":    { "type": "string", "enum": ["rewrite", "append"], "default": "rewrite" }
    },
    "required": ["path", "content"]
  },

  "create_directory": {
    "type": "object",
    "properties": {
      "path": { "type": "string" }
    },
    "required": ["path"]
  },

  "list_directory": {
    "type": "object",
    "properties": {
      "path":  { "type": "string" },
      "depth": { "type": "number", "default": 2 }
    },
    "required": ["path"]
  },

  "move_file": {
    "type": "object",
    "properties": {
      "source":      { "type": "string" },
      "destination": { "type": "string" }
    },
    "required": ["source", "destination"]
  },

  "start_search": {
    "type": "object",
    "properties": {
      "path":        { "type": "string" },
      "pattern":     { "type": "string" },
      "searchType":  { "type": "string", "enum": ["files", "content"], "default": "files" },
      "filePattern": { "type": "string" },
      "ignoreCase":  { "type": "boolean", "default": true },
      "maxResults":  { "type": "number" }
    },
    "required": ["path", "pattern"]
  },

  "get_more_search_results": {
    "type": "object",
    "properties": {
      "sessionId": { "type": "string" },
      "offset":    { "type": "number", "default": 0 },
      "length":    { "type": "number", "default": 100 }
    },
    "required": ["sessionId"]
  },

  "start_process": {
    "type": "object",
    "properties": {
      "command":    { "type": "string" },
      "timeout_ms": { "type": "number" },
      "shell":      { "type": "string" }
    },
    "required": ["command", "timeout_ms"]
  },

  "read_process_output": {
    "type": "object",
    "properties": {
      "pid":        { "type": "number" },
      "timeout_ms": { "type": "number" },
      "offset":     { "type": "number" },
      "length":     { "type": "number" }
    },
    "required": ["pid"]
  },

  "interact_with_process": {
    "type": "object",
    "properties": {
      "pid":             { "type": "number" },
      "input":           { "type": "string" },
      "timeout_ms":      { "type": "number" },
      "wait_for_prompt": { "type": "boolean" }
    },
    "required": ["pid", "input"]
  },

  "search": {
    "_source": "free_search — reconstruido desde manifest.ts",
    "type": "object",
    "properties": {
      "query":       { "type": "string" },
      "max_results": { "type": "number" }
    },
    "required": ["query"]
  },

  "fetch": {
    "_source": "free_search — reconstruido desde manifest.ts",
    "type": "object",
    "properties": {
      "url":           { "type": "string" },
      "render":        { "type": "boolean" },
      "force_refresh": { "type": "boolean" },
      "max_age_hours": { "type": "number" }
    },
    "required": ["url"]
  },

  "fetch_batch": {
    "_source": "free_search — reconstruido desde manifest.ts",
    "type": "object",
    "properties": {
      "urls":   { "type": "array", "items": { "type": "string" } },
      "render": { "type": "boolean" }
    },
    "required": ["urls"]
  }
}
